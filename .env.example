# Server port (Render & Hugging Face Spaces inject PORT automatically)
PORT=3000

# Optional API key to protect endpoints (leave empty for easy local testing)
API_SECRET=

# Default IANA timezone used if a schedule does not include one
DEFAULT_TIMEZONE=UTC

# Optional: Free MongoDB Atlas connection string so WhatsApp login & schedules
# survive server restarts on free hosts like Render.com or Hugging Face Spaces.
# Leave empty to store everything locally in ./data and ./auth_info_baileys.
MONGO_URI=

